-Info "Busca sanity"
-Add-Type -AssemblyName System.Web
-$q = [System.Web.HttpUtility]::UrlEncode("alca bolsa madeira")
-$searchUrl = "$BaseUrl/api/v1/catalog/search?q=$q&k=$K"
-try { $search = Invoke-RestMethod -Uri $searchUrl -TimeoutSec 120 } catch {
