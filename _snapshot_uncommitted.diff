-$report.Add("- top1 product_id: $productId")
-
-# Chat
-Info "Chat E2E"
-$chatBody = @{ message = "Quais produtos de alça de bolsa em madeira temos?"; tenant_id = $TenantId } | ConvertTo-Json
-$chatOk = $false
-$chatEndpoint = $null
-foreach ($u in @("$BaseUrl/api/v1/chat", "$BaseUrl/api/v1/chat_v2")) {
