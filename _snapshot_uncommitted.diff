-    Warn "Sem endpoint de métricas acessível agora. Continuando mesmo assim."
-  } else {
-    Ok "Métricas OK: $metricsUrl"
-  }
-} else {
-  Ok "Métricas OK: $metricsUrl"
-}
-
-# --- Catalog rebuild
-Info "Rebuild do Catálogo (FULL + activate=true)"
