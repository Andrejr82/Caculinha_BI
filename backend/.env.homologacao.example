# =============================================================================
# Caculinha BI Backend - Homologacao Empresa (Parquet-First)
# =============================================================================

# App / Runtime
DEBUG=false
ENVIRONMENT=staging
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true

# API / CORS
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=https://SEU_FRONTEND_HOMOLOG
CORS_ORIGINS=https://SEU_FRONTEND_HOMOLOG

# Security
SECRET_KEY=PREENCHER_SECRET_KEY_HOMOLOG
JWT_SECRET=PREENCHER_JWT_SECRET_HOMOLOG
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=5

# SQL Server / Chat State
# O SQL Server e usado apenas para sessoes, historico e feedback do chat.
# Para runtime local controlado com pytds, manter USE_SQL_SERVER=false e usar DATABASE_URL mssql+pytds.
# Se o servidor corporativo usar ODBC/aioodbc, trocar para USE_SQL_SERVER=true e preencher PYODBC_CONNECTION_STRING.
USE_SQL_SERVER=false
CHAT_STATE_BACKEND=sqlserver
CHAT_STATE_SQLITE_FALLBACK_ENABLED=false
FALLBACK_TO_PARQUET=true
SQL_SERVER_TIMEOUT=2
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DATABASE_URL=mssql+pytds://USUARIO_CHAT:SENHA_CHAT@HOST_SQLSERVER:1433/BANCO_CHAT
PYODBC_CONNECTION_STRING=

# Redis
# Primeira homologacao sem Redis.
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_KEY_PREFIX=caculinha
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2

# Runtime Storage / Analytics
# A base analitica principal deve vir do parquet corporativo.
CACHE_TTL_MINUTES=360
CACHE_MAX_AGE_DAYS=7
AGENT_GRAPH_CACHE_TTL_MINUTES=360
CACHE_DIR=data/cache_v2
RUNTIME_STORAGE_ROOT=data/runtime
CHAT_STATE_DB_PATH=data/runtime/chat_state/agentbi.db
VECTOR_DB_PATH=data/runtime/chat_state/conversation_vectors.duckdb
SESSION_LEGACY_STORAGE_PATH=data/runtime/sessions
ATTACHMENTS_STORAGE_PATH=data/runtime/attachments
PARQUET_DATA_PATH=CAMINHO_CORPORATIVO_DO_PARQUET\\admmat.parquet
PARQUET_FILE_PATH=CAMINHO_CORPORATIVO_DO_PARQUET\\admmat.parquet
RAG_FAISS_INDEX_PATH=data/rag/faiss_index.bin
LEARNING_FEEDBACK_PATH=data/feedback/
LEARNING_EXAMPLES_PATH=data/learning/
LEARNING_MAX_EXAMPLES=1000

# LLM
LLM_PROVIDER=groq
LLM_MODEL_NAME=llama-3.3-70b-versatile
GROQ_API_KEY=PREENCHER_GROQ_API_KEY
GROQ_MODEL_NAME=llama-3.3-70b-versatile
DEV_FAST_MODE=false
LLM_MAX_OUTPUT_TOKENS=2048
LLM_HISTORY_MAX_MESSAGES=15
INTENT_CLASSIFICATION_MODEL=llama-3.3-70b-versatile
CODE_GENERATION_MODEL=llama-3.3-70b-versatile

# Canario opcional de homologacao
# GROQ_MODEL_NAME=openai/gpt-oss-120b
# CODE_GENERATION_MODEL=openai/gpt-oss-120b

# Supabase Auth
USE_SUPABASE_AUTH=true
SUPABASE_URL=PREENCHER_SUPABASE_URL
SUPABASE_ANON_KEY=PREENCHER_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=PREENCHER_SUPABASE_SERVICE_ROLE_KEY
