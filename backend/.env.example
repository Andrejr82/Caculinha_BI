# =============================================================================
# Caculinha BI Backend - Environment template
# =============================================================================

# App
APP_NAME=Agent BI Backend
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# API
API_V1_PREFIX=/api/v1
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Database / Chat State
# Analytics de negocio usam `PARQUET_DATA_PATH`.
# `DATABASE_URL` / `PYODBC_CONNECTION_STRING` servem apenas para estado transacional do chat
# (sessions, history, feedback) quando `CHAT_STATE_BACKEND=sqlserver`.
DATABASE_URL=
PYODBC_CONNECTION_STRING=
USE_SQL_SERVER=false
FALLBACK_TO_PARQUET=true
SQL_SERVER_TIMEOUT=2
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis
# Primeira homologacao pode operar com Redis desabilitado.
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
REDIS_ENABLED=false
REDIS_REQUIRED=false
REDIS_KEY_PREFIX=caculinha
REDIS_SOCKET_TIMEOUT_SECONDS=2
REDIS_CONNECT_TIMEOUT_SECONDS=2

# Cache / Paths
CACHE_TTL_MINUTES=360
CACHE_MAX_AGE_DAYS=7
AGENT_GRAPH_CACHE_TTL_MINUTES=360
CACHE_DIR=data/cache_v2
RUNTIME_STORAGE_ROOT=data/runtime
# Produção/homologacao recomendada: CHAT_STATE_BACKEND=sqlserver
# Dev/local: sqlite
CHAT_STATE_BACKEND=sqlite
CHAT_STATE_SQLITE_FALLBACK_ENABLED=true
CHAT_STATE_DB_PATH=data/runtime/chat_state/agentbi.db
VECTOR_DB_PATH=data/runtime/chat_state/conversation_vectors.duckdb
SESSION_LEGACY_STORAGE_PATH=data/runtime/sessions
ATTACHMENTS_STORAGE_PATH=data/runtime/attachments
PARQUET_DATA_PATH=data/parquet/admmat.parquet
PARQUET_FILE_PATH=data/parquet/admmat.parquet
RAG_FAISS_INDEX_PATH=data/rag/faiss_index.bin
LEARNING_FEEDBACK_PATH=data/feedback/
LEARNING_EXAMPLES_PATH=data/learning/
LEARNING_MAX_EXAMPLES=1000

# Security (minimum 32 chars)
SECRET_KEY=replace-with-your-secure-secret-key-min-32-chars
JWT_SECRET=replace-with-your-secure-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=5

# Logging / Metrics
LOG_LEVEL=INFO
LOG_FORMAT=json
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# LLM
LLM_PROVIDER=groq
LLM_FALLBACK_PROVIDERS=groq
PLAYGROUND_MODE=local_only
PLAYGROUND_CANARY_ENABLED=false
PLAYGROUND_CANARY_ALLOWED_ROLES=admin
PLAYGROUND_CANARY_ALLOWED_USERS=
CHAT_CANARY_ENABLED=false
CHAT_CANARY_ALLOWED_ROLES=admin,analyst,user
CHAT_CANARY_ALLOWED_USERS=
GEMINI_API_KEY=
LLM_MODEL_NAME=gemini-2.5-pro
GROQ_API_KEY=
# Default atual e estavel para producao.
GROQ_MODEL_NAME=llama-3.3-70b-versatile
# Canario recomendado em homologacao Groq:
# GROQ_MODEL_NAME=openai/gpt-oss-120b
DEV_FAST_MODE=false
LLM_MAX_OUTPUT_TOKENS=2048
LLM_HISTORY_MAX_MESSAGES=15
OBS_COST_USD_PER_1K_INPUT_TOKENS=0
OBS_COST_USD_PER_1K_OUTPUT_TOKENS=0
# Recomenda-se manter classificacao de intencao no modelo estavel atual.
INTENT_CLASSIFICATION_MODEL=llama-3.3-70b-versatile
# Canario opcional para tarefas de codigo em homologacao:
# CODE_GENERATION_MODEL=openai/gpt-oss-120b
CODE_GENERATION_MODEL=llama-3.3-70b-versatile

# Supabase (disable auth locally if not configured)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
USE_SUPABASE_AUTH=false

# Competitive Intelligence (public evidence only by default)
COMPETITIVE_INTEL_ENABLED=true
COMPETITIVE_PROVIDER_PRIORITY=playwright,crawler,websearch,social,mercadolivre,google_shopping,serpapi,bellart
COMPETITIVE_ALLOW_MANUAL=false
COMPETITIVE_ALLOWED_STATES=RJ,MG,ES
COMPETITIVE_HTTP_TIMEOUT_SEC=10
COMPETITIVE_TOTAL_TIMEOUT_SEC=25
COMPETITIVE_MAX_RESULTS=20
COMPETITIVE_MANUAL_FILE=data/reference/competitive_prices.json
COMPETITIVE_DOMAIN_WHITELIST=bellartdecor.com.br,kalunga.com.br,americanas.com.br,casaevideo.com.br,lebiscuit.com.br,mercadolivre.com.br,amazon.com.br,shopee.com.br,google.com,shopping.google.com,google.com.br,oamigao.com.br,tubaraoatacadao.com.br,instagram.com,facebook.com
SERPAPI_API_KEY=
SERPAPI_ENGINE=google_shopping
