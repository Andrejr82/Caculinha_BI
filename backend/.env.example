# Safe local defaults. Never commit real credentials to this file.
SECRET_KEY=change-this-local-secret-key-with-at-least-32-characters
ENVIRONMENT=development
DEBUG=false

# Keep external providers disabled for local tests unless explicitly configured.
LLM_PROVIDER=mock
LLM_FALLBACK_PROVIDERS=mock
GROQ_API_KEY=
GEMINI_API_KEY=

# Local data-first mode.
DATABASE_URL=
USE_SQL_SERVER=false
FALLBACK_TO_PARQUET=true
USE_SUPABASE_AUTH=false
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
